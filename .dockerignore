# Git, IDE, and Python caches
.git
.gitignore
__pycache__/
*.py[cod]
*$py.class
.vscode/
.idea/
docs/
src/

# Exclude large PyTorch training checkpoints (only ONNX Runtime models are needed in production)
experiments/**/*.pt
experiments/**/*.pth

